# Port on the host machine to expose the site on.
HOST_PORT=8084

# Which released image `docker compose up -d` pulls from GHCR: "latest", a minor
# line like "0.2", or an exact "0.2.1". Ignored when you build with --build.
TAG=latest

# Build-time site configuration. These apply only when you BUILD (`--build`) — they
# are baked into the static site, so changing one requires a rebuild:
#   docker compose up -d --build
# The released image is built by CI with the defaults, so these have no effect on a
# plain `docker compose up -d`, which pulls that image rather than building.

# Browser tab title and page heading for each page.
PUBLIC_SITE_TITLE_TI84=TI-84 Calculator
PUBLIC_SITE_TITLE_GRAPHING=Graphing Calculator Online
PUBLIC_SITE_TITLE_EXPLORERS=Explorers
PUBLIC_SITE_TITLE_FUNCTION_EXPLORER=Function Explorer
PUBLIC_SITE_TITLE_TRANSFORMATION_EXPLORER=Transformation Explorer

# Source URL for the embedded TI-84 iframe on the /ti-84 page.
PUBLIC_TI84_IFRAME_SRC=https://ti84calc.com/ti84calc

# Default theme for first-time visitors: "dark" or "light".
# Visitors can still toggle; their choice is saved in localStorage.
PUBLIC_THEME_DEFAULT=dark
